// UniFFI interface definition for trace-core's public API.
//
// Phase 1: this file is committed as the canonical surface but not yet wired
// into the build (no `uniffi` dep, no `build.rs`). Phase 4 (iOS) adds the
// build wiring and re-enables this as the source of Swift, Kotlin, and React
// Native bindings.
//
// The shape mirrors `crate::api::TraceFile` and (later) `crate::session::Session`.

namespace trace_core {};

// === Errors ===
[Error]
interface TraceError {
  SvgParse(string message);
  InvalidFile(string message);
  UnsupportedVersion(u16 major, u16 minor);
  UnknownId(string id);
  LimitExceeded(string limit);
  Internal(string message);
};

// === Value types ===
dictionary ViewBox { f32 x; f32 y; f32 w; f32 h; };
dictionary Rect    { f32 min_x; f32 min_y; f32 max_x; f32 max_y; };
dictionary Rgba    { u32 packed; };

enum HitMode { "VisiblePainted", "VisibleStroke", "VisibleFill", "All", "BoundingBox" };

// === TraceFile (read-side) ===
interface TraceFile {
  [Throws=TraceError]
  constructor(sequence<u8> bytes);

  ViewBox viewbox();
  u32 element_count();
  sequence<string> ids();
  string? metadata(string key);

  // Hit-test (phase 3+).
  string? hit_test(f32 x, f32 y, HitMode mode);
};

// === Session (streaming) — phase 6 ===
// Placeholder; full surface lands when streaming does.
